{
  "name": "nsi-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test:unit": "jest --passWithNoTests",
    "test:e2e": "playwright test --reporter=list",
    "test": "npm run test:unit && npm run test:e2e",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.int.config.js",
    "e2e:api": "playwright test tests/e2e/api_validation.spec.ts",
    "e2e:critical": "playwright test tests/e2e/student_golden_path.spec.ts tests/e2e/teacher_consultation.spec.ts",
    "e2e:headed": "playwright test --headed",
    "e2e:load": "PLAYWRIGHT_JSON_OUTPUT_NAME=load.json playwright test tests/e2e/load_class.spec.ts",
    "preprod:smoke": "node ./scripts/preprod_smoke.js",
    "postrm": "echo noop"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.653.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^3.4.4",
    "@sentry/nextjs": "^8.20.0",
    "@types/bcrypt": "^6.0.0",
    "argon2": "^0.31.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.7.7",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "ioredis": "^5.4.1",
    "jose": "^5.2.4",
    "lucide-react": "^0.542.0",
    "mime-types": "^2.1.35",
    "next": "^14.2.32",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swr": "^2.2.5",
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.52.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.47.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/busboy": "^1.5.4",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.1.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.13",
    "ts-jest": "^29.4.1"
  },
  "playwright": {
    "baseURL": "http://localhost:3000"
  }
}
