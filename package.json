{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm -w nsi-web run dev",
    "build": "npm -w nsi-web run build",
    "start": "npm -w nsi-web run start",
    "test": "npm -w nsi-web run test",
    "e2e": "playwright test",
    "preprod:smoke": "npm -w nsi-web run preprod:smoke",
    "docker:preprod:smoke": "docker compose -f infra/docker-compose.yml exec -T web npm run preprod:smoke",
    "job:test": "ts-node -P tsconfig.scripts.json scripts/push_job_generate_reports.ts --email=$EMAIL --scores=$SCORES",
    "ingest:rag": "ts-node -P tsconfig.scripts.json scripts/ingest_rag.ts",
    "seed:production": "ts-node -P tsconfig.scripts.json scripts/seed_production_data.ts",
    "seed:curriculum": "ts-node -P tsconfig.scripts.json scripts/seed-curriculum.ts",
    "seed:exercises": "ts-node -P tsconfig.scripts.json scripts/seed-exercises.ts",
    "docker:job:test": "docker compose -f infra/docker-compose.yml exec web env REDIS_URL=$REDIS_URL npx ts-node -P tsconfig.scripts.json /app/scripts/push_job_generate_reports.ts --email=$EMAIL --scores=$SCORES",
    "docker:ingest:rag": "docker compose -f infra/docker-compose.yml exec web env HF_TOKEN=$HF_TOKEN DATABASE_URL=$DATABASE_URL npx ts-node -P tsconfig.scripts.json /app/scripts/ingest_rag.ts",
    "docker:seed:production": "docker compose -f infra/docker-compose.yml exec web env DATABASE_URL=$DATABASE_URL npx ts-node -P tsconfig.scripts.json /app/scripts/seed_production_data.ts",
    "seed:users": "ts-node -P tsconfig.scripts.json scripts/seed_users_from_csv.ts",
    "upload:test": "echo 'TODO: curl -F file=@mon.pdf https://nsi.labomaths.tn/api/rag/upload'",
    "validate:volet1": "bash scripts/validate_volet1.sh",
    "perf:test": "npx ts-node -T scripts/run_full_test_scenario.ts",
    "audit:fake-bilan": "ts-node -P tsconfig.scripts.json scripts/generate_fake_bilan.ts",
    "monitor:daily": "bash scripts/monitor_daily_perf.sh",
    "install:resources": "node scripts/install_resources.js",
    "update:rag": "node scripts/update_rag_mapping.js",
    "docker:db:push": "docker compose -f infra/docker-compose.yml exec -T web npx prisma db push",
    "docker:seed:evaluations": "docker compose -f infra/docker-compose.yml exec -T web node /app/scripts/seed_evaluations_from_json.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "babel-jest": "^30.1.2",
    "jest": "^30.1.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "argon2": "^0.31.2",
    "bcrypt": "^6.0.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "ioredis": "^5.4.1",
    "jose": "^6.1.0",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0"
  }
}
