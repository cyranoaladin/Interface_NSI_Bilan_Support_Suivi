datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// === AUTH MODELS ===

model Student {
  // Spéc: email est la clé primaire
  email                  String   @id
  givenName              String
  familyName             String
  classe                 String
  specialites            String
  active                 Boolean  @default(true)
  passwordHash           String
  passwordChangeRequired Boolean  @default(true)

  // Relations
  attempts    Attempt[]
  profileData StudentProfileData?
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bilans      Bilan[]
  evalBilans  EvaluationBilan[]

  @@index([groupId])
}

model Attempt {
  id            String    @id @default(cuid())
  // Spéc: flag de réactivation
  isActive      Boolean   @default(true)

  studentEmail  String
  student       Student   @relation(fields: [studentEmail], references: [email])
  questionnaire String
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  status        String    @default("in_progress")
  scores        Score[]
  tags          Tag[]
  reports       Report[]

  // Optionnel: tentative liée à un groupe/classe
  groupId String?
  group   Group?   @relation(fields: [groupId], references: [id])

  @@index([studentEmail])
  @@index([groupId])
}

model Score {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id])
  domain    String
  pct       Float
  raw       Float
  weight    Float

  @@index([attemptId])
  @@index([attemptId, domain])
}

model Tag {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id])
  code      String

  @@index([attemptId])
}

model Report {
  id          String    @id @default(cuid())
  attemptId   String
  attempt     Attempt   @relation(fields: [attemptId], references: [id])
  type        String // 'eleve' | 'enseignant'
  json        Json
  pdfUrl      String?
  publishedAt DateTime?

  @@index([attemptId])
}

model Teacher {
  // Spéc: email est la clé primaire
  email                  String   @id
  firstName              String
  lastName               String
  passwordHash           String
  passwordChangeRequired Boolean  @default(true)

  // Groupes enseignés (via table de jointure)
  groups TeacherOnGroup[]
}

// === GROUP / CLASSES ===
model Group {
  id           String           @id @default(cuid())
  name         String           @unique
  code         String           @unique
  academicYear String           // ex: "2024-2025"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  students     Student[]
  attempts     Attempt[]
  teachers     TeacherOnGroup[]

  @@index([academicYear])
}

model TeacherOnGroup {
  teacherEmail String
  groupId      String
  role      String   @default("teacher") // main | teacher | assistant

  teacher   Teacher  @relation(fields: [teacherEmail], references: [email])
  group     Group    @relation(fields: [groupId], references: [id])

  @@id([teacherEmail, groupId])
  @@index([groupId])
}

// PasswordReset n'est plus utilisé sans User central. Supprimé.

// === BILAN MODELS ===
model Bilan {
  id               String   @id @default(cuid())
  authorEmail      String
  authorRole       String // 'teacher' | 'student'

  studentEmail     String?
  student          Student? @relation(fields: [studentEmail], references: [email])

  matiere          String?
  niveau           String?

  qcmRawAnswers    Json?
  pedagoRawAnswers Json?

  qcmScores        Json?
  pedagoProfile    Json?
  preAnalyzedData  Json?

  reportText       String?
  summaryText      String?

  generatedAt      DateTime?
  status           String   @default("PENDING")
  variant          String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([authorEmail])
  @@index([studentEmail])
}

model StudentProfileData {
  id               String   @id @default(cuid())
  studentEmail     String   @unique
  student          Student  @relation(fields: [studentEmail], references: [email])

  pedagoRawAnswers Json?
  pedagoProfile    Json?
  preAnalyzedData  Json?
  lastUpdatedAt    DateTime @default(now())
}

// === EVALUATIONS (Bilans évaluations) ===
model Evaluation {
  id     Int                @id @default(autoincrement())
  title  String
  date   DateTime

  bilans EvaluationBilan[]
}

model EvaluationBilan {
  id                   Int       @id @default(autoincrement())
  studentEmail         String
  evaluationId         Int
  noteFinale           String
  appreciationGenerale String
  pointsForts          Json
  axesAmelioration     Json
  conseils             Json

  student    Student    @relation(fields: [studentEmail], references: [email])
  evaluation Evaluation @relation(fields: [evaluationId], references: [id])

  @@unique([studentEmail, evaluationId])
  @@index([studentEmail])
  @@index([evaluationId])
}

// === RAG MODELS (DB tables existantes) ===
model Document {
  id     String  @id @db.Uuid @default(dbgenerated("gen_random_uuid()"))
  source String? @db.Text
  path   String  @db.Text
  title  String? @db.Text
  label  String? @db.Text
  meta   Json?   @db.JsonB

  @@map("documents")
}

// === EXTENSION « Programme & Quiz » ===

enum ExerciseType { QCM OUVERT CODING }

enum Difficulty { EASY MEDIUM HARD }

model CurrTheme {
  id       String      @id @default(cuid())
  code     String      @unique
  title    String
  order    Int
  parentId String?
  parent   CurrTheme?  @relation("ThemeParent", fields: [parentId], references: [id])
  children CurrTheme[] @relation("ThemeParent")

  notions  Notion[]

  @@index([parentId])
  @@index([order])
}

model Notion {
  id       String    @id @default(cuid())
  code     String    @unique
  title    String
  order    Int       @default(0)
  themeId  String
  theme    CurrTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  // liens
  resources ResourceNotion[]
  exercises ExerciseNotion[]
  mastery   StudentMastery[]
  coverage  TeacherCoverage[]
  documents DocumentNotion[]

  @@index([themeId])
}

model TeacherCoverage {
  id          String   @id @default(cuid())
  teacherId   String
  groupId     String?
  notionId    String
  coveredAt   DateTime @default(now())
  durationMin Int?
  notes       String?

  notion      Notion   @relation(fields: [notionId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([groupId])
  @@index([notionId, coveredAt])
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  s3Key        String
  mime         String
  size         Int
  uploadedById String
  uploadedAt   DateTime @default(now())
  notions      ResourceNotion[]

  @@index([uploadedById])
  @@index([s3Key])
}

model ResourceNotion {
  resourceId String
  notionId   String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  notion     Notion   @relation(fields: [notionId], references: [id], onDelete: Cascade)
  @@id([resourceId, notionId])
  @@index([notionId])
}

model Exercise {
  id          String       @id @default(cuid())
  title       String
  type        ExerciseType
  statementMd String
  rubricJson  Json?
  difficulty  Difficulty
  createdAt   DateTime     @default(now())
  notions     ExerciseNotion[]
  items       QuizItem[]

  @@index([type])
  @@index([difficulty])
}

model ExerciseNotion {
  exerciseId String
  notionId   String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  notion     Notion   @relation(fields: [notionId], references: [id], onDelete: Cascade)
  @@id([exerciseId, notionId])
}

model Quiz {
  id          String     @id @default(cuid())
  title       String?
  studentId   String?
  createdById String
  createdAt   DateTime   @default(now())
  items       QuizItem[]
  submissions QuizSubmission[]

  @@index([studentId])
  @@index([createdById])
}

model QuizItem {
  id         String   @id @default(cuid())
  quizId     String
  exerciseId String
  /// ordre d’affichage
  order      Int
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  submissions SubmissionItem[]

  @@index([quizId])
  @@index([exerciseId])
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  startedAt   DateTime @default(now())
  submittedAt DateTime?
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  items       SubmissionItem[]

  @@index([quizId])
  @@index([studentId, submittedAt])
}

model SubmissionItem {
  id            String   @id @default(cuid())
  submissionId  String
  quizItemId    String
  answerJson    Json?
  codePy        String?
  createdAt     DateTime @default(now())
  submission    QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  quizItem      QuizItem      @relation(fields: [quizItemId], references: [id])
  grading       SubmissionItemGrading?

  @@index([submissionId])
  @@index([quizItemId])
}

model SubmissionItemGrading {
  id               String   @id @default(cuid())
  submissionItemId String   @unique
  score            Float
  openFeedbackJson Json?
  codeReviewJson   Json?
  gradedAt         DateTime @default(now())
  item             SubmissionItem @relation(fields: [submissionItemId], references: [id], onDelete: Cascade)
}

model StudentMastery {
  id        String   @id @default(cuid())
  studentId String
  notionId  String
  mastery   Float
  updatedAt DateTime @default(now())
  notion    Notion   @relation(fields: [notionId], references: [id])

  @@unique([studentId, notionId])
  @@index([notionId])
}

/// Relie les documents existants aux notions
model DocumentNotion {
  documentId String @db.Uuid
  notionId   String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  notion     Notion   @relation(fields: [notionId], references: [id], onDelete: Cascade)
  @@id([documentId, notionId])
  @@index([notionId])
}
